# Maestro / BotCity
MAESTRO_ENABLED=false
MAESTRO_SERVER=
MAESTRO_LOGIN=
MAESTRO_KEY=
DATAPOOL_LABEL=FilaAuditoriaLotes

# Pipeline Capstone
CAPSTONE_ENABLED=true
ORCHESTRATOR_MODE=shadow
CAPSTONE_BUSINESS_KEY=
CAPSTONE_STATE_DIR=data/capstone_state
CAPSTONE_DESKTOP_MODE=simulated
CAPSTONE_WEB_MODE=simulated
CAPSTONE_DESKTOP_RETRY_ATTEMPTS=3
CAPSTONE_WEB_RETRY_ATTEMPTS=3
CAPSTONE_RETRY_DELAY_SECONDS=1
CAPSTONE_DESKTOP_STARTUP_SECONDS=2
CAPSTONE_DESKTOP_EXPORT_TIMEOUT_SECONDS=20

# Labels registrados no Maestro
PIPELINE_BOT_CAPSTONE_LABEL=teodorio-orquestrador-capstone-v1
PIPELINE_BOT_DESKTOP_LABEL=teodorio-coleta-desktop-v1
PIPELINE_BOT_WEB_LABEL=teodorio-coleta-web-v1
PIPELINE_BOT_CONSOLIDACAO_LABEL=teodorio-consolidacao-v1
PIPELINE_BOT_ML_LABEL=teodorio-classificador-ml-v1
PIPELINE_BOT_RELATORIO_LABEL=teodorio-relatorio-alertas-v1

# Prioridades (0-10)
PIPELINE_DESKTOP_PRIORITY=9
PIPELINE_WEB_PRIORITY=7
PIPELINE_CONSOLIDACAO_PRIORITY=8
PIPELINE_ML_PRIORITY=5
PIPELINE_RELATORIO_PRIORITY=6
PIPELINE_TEST_MODE=false
PIPELINE_WAIT_TIMEOUT_SECONDS=300
PIPELINE_POLL_INTERVAL_SECONDS=5

# Fontes de dados
ARQUIVO_INSPECAO=dados_entrada/inspecao_lotes_dia.xlsx
ARQUIVO_BASE_REFERENCIA=dados_entrada/inspecao_lotes_dia.xlsx
