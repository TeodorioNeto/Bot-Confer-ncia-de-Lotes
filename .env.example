# Web
WEB_AUTOMATION_ENABLED=false
WEB_AUTOMATION_DRIVER=selenium
WEB_AUTOMATION_URL=

# ML opcional e nunca critico
ML_ENABLED=true
ML_CONFIANCA_MINIMA=0.85
ML_DIVERGENCIA_URL=
ML_DIVERGENCIA_TIMEOUT_SECONDS=2
ML_DIVERGENCIA_MOCK_DELAY_SECONDS=0
ML_DIVERGENCIA_FORCE_CONFIDENCE=
ML_DIVERGENCIA_FORCE_ERROR=false

# Alertas - preencher apenas no ambiente/Vault
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
